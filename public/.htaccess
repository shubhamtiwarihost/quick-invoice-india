# Never serve dotfiles such as .env (credentials live there)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Serve ES modules (e.g. the pdf.js worker *.mjs) as JavaScript — browsers refuse
# to run module scripts served as text/plain, which breaks all PDF reading.
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization Header to PHP on Apache / Hostinger
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Canonical Domain: Force non-WWW (301 Permanent Redirect to prevent duplicate content)
  RewriteCond %{HTTP_HOST} ^www\.swiftgst\.in$ [NC]
  RewriteRule ^(.*)$ https://swiftgst.in/$1 [L,R=301]

  # Route API calls directly to PHP
  RewriteRule ^api/(.*\.php)$ api/$1 [L,QSA]
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]
  RewriteRule ^api/auth/?$ api/auth.php [L,QSA]
  RewriteRule ^api/track/?$ api/track.php [L,QSA]
  RewriteRule ^api/stats/?$ api/stats.php [L,QSA]
  RewriteRule ^api/agent/?$ api/agent.php [L,QSA]
  RewriteRule ^api/(.*)$ api/$1 [L,QSA]

  # Allow direct access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route PDF Tools & PDF Editor SPA sub-routes directly to /pdf-tools/index.html
  RewriteRule ^pdf-editor/.*$ /pdf-tools/index.html [L]
  RewriteRule ^pdf-editor/?$ /pdf-tools/ [L,R=301]
  RewriteRule ^pdf-tools/.*$ /pdf-tools/index.html [L]
  RewriteRule ^tools/?$ /pdf-tools/ [L,R=301]

  # Handle Next.js clean URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Unknown URLs must return a real 404 (see ErrorDocument below). Serving the homepage
  # with a 200 status for every missing URL creates "soft 404" duplicates that Google
  # reports as duplicate or non-indexed pages. Every real route is a static folder, so
  # no route depends on an index.html fallback.
</IfModule>

ErrorDocument 404 /404.html

# Static Asset Long-Term Caching via mod_expires
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & WebP & SVG
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # Stylesheets & Scripts
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Web App Manifest & App Data
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Cache-Control and Security Headers for Modern Browsers
<IfModule mod_headers.c>
  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 1-year immutable caching for static assets
  <FilesMatch "\.(js|mjs|css|webp|svg|png|jpg|jpeg|gif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML documents should always revalidate so users receive fresh updates
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
