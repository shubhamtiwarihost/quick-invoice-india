# ==============================================================================
# DOCUSHIELD PDF - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================

# Google Analytics 4 Measurement ID (e.g., G-ABC123XYZ)
# Leave blank or set to G-XXXXXXXXXX to run in pure offline/local telemetry mode
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Internal Admin Telemetry Console Password / PIN (Route: /admin or #admin)
# Used to authenticate access to operational performance metrics and CSV exports
VITE_ADMIN_PASS=your_secure_admin_pin
