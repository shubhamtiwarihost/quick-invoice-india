# Hostinger SMTP Configuration for Contact Form Email Delivery
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@swiftgst.in
SMTP_PASS=your_email_password

# MySQL Database Configuration for Auth & Cloud Sync
# On Hostinger, put the real .env OUTSIDE the web root: domains/swiftgst.in/.env
# (never commit it). The API has no hardcoded fallback credentials.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_swiftgst
DB_USER=u123456789_admin
DB_PASS=your_db_password

# Browser origins allowed to call /api (comma-separated). Defaults to the live site.
# ALLOWED_ORIGINS=https://swiftgst.in,https://www.swiftgst.in

# Google Gemini Free Tier AI Co-Pilot API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here


# Admin dashboard key (required for /api/stats.php and the admin pages). Use a long random value.
# Without it the stats endpoint rejects every request.
ADMIN_KEY=change_me_to_a_long_random_secret
